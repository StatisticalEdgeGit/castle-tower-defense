{
  "name": "castle-tower-defense",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer co-op / versus tower defense (local + LAN testing build)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"cross-env DEV_TOOLS=1 tsx watch src/server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "play": "npm run build && cross-env DEV_TOOLS=1 npm start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
